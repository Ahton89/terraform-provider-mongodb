# {{.Type}}: {{.Name}}

{{ .Description | trimspace }}

Initializes and manages MongoDB replica set configurations. A replica set provides redundancy and high availability through automatic failover.

~> **Important:** Updating members can currently only add/change members **one at a time** after initial creation. When first creating the replica set, you can specify any number of members.

~> **Warning:** This resource does **not support deletion**. Removing replica sets requires manual intervention and careful planning. The resource will only be removed from Terraform state upon destroy.

-> **Note:** Replica set names are **immutable** and cannot be changed after creation.

## Example Usage

### Basic Three-Node Replica Set

```terraform
resource "mongodb_replicaset" "main" {
  name = "rs0"

  members = [
    {
      id   = 0
      host = "mongodb-1.example.com:27017"
    },
    {
      id   = 1
      host = "mongodb-2.example.com:27017"
    },
    {
      id   = 2
      host = "mongodb-3.example.com:27017"
    }
  ]
}
```

### With Arbiter Node

```terraform
resource "mongodb_replicaset" "with_arbiter" {
  name = "rs-prod"

  members = [
    {
      id   = 0
      host = "mongodb-primary:27017"
    },
    {
      id   = 1
      host = "mongodb-secondary:27017"
    },
    {
      id   = 2
      host = "mongodb-arbiter:27017"
      arbiter_only = true  # Arbiter doesn't store data
    }
  ]
}
```

### With Priority-Based Failover

```terraform
resource "mongodb_replicaset" "priority" {
  name = "rs-ha"

  members = [
    {
      id       = 0
      host     = "mongodb-primary:27017"
      priority = 2  # Preferred primary
    },
    {
      id       = 1
      host     = "mongodb-secondary-1:27017"
      priority = 1  # Lower priority
    },
    {
      id       = 2
      host     = "mongodb-secondary-2:27017"
      priority = 1
    }
  ]
}
```

### With Hidden and Delayed Secondary

```terraform
resource "mongodb_replicaset" "delayed" {
  name = "rs-backup"

  members = [
    {
      id   = 0
      host = "mongodb-primary:27017"
    },
    {
      id   = 1
      host = "mongodb-secondary:27017"
    },
    {
      id                  = 2
      host                = "mongodb-delayed:27017"
      hidden              = true  # Not visible to application
      priority            = 0     # Cannot become primary
      secondary_delay_secs = 3600  # 1 hour delay (disaster recovery)
    }
  ]
}
```

### With Custom Settings

```terraform
resource "mongodb_replicaset" "custom" {
  name = "rs-custom"

  members = [
    {
      id   = 0
      host = "mongo1:27017"
    },
    {
      id   = 1
      host = "mongo2:27017"
    },
    {
      id   = 2
      host = "mongo3:27017"
    }
  ]

  settings = {
    chaining_allowed             = true
    heartbeat_interval_millis    = 2000
    heartbeat_timeout_secs       = 10
    election_timeout_millis      = 10000
    catch_up_timeout_millis      = -1  # Infinite timeout
    catch_up_takeover_delay_millis = 30000

    get_last_error_defaults = {
      w        = 1
      wtimeout = 0
    }
  }

  protocol_version                       = 1
  write_concern_majority_journal_default = true
}
```

### Complete High-Availability Setup

```terraform
# Local variables for replica set configuration
locals {
  replica_set_name = "rs-${var.environment}"

  members = [
    {
      id       = 0
      host     = "mongodb-az1.${var.region}.compute.internal:27017"
      priority = 2
    },
    {
      id       = 1
      host     = "mongodb-az2.${var.region}.compute.internal:27017"
      priority = 1
    },
    {
      id       = 2
      host     = "mongodb-az3.${var.region}.compute.internal:27017"
      priority = 1
    }
  ]
}

# Direct connection for replica set initialization
provider "mongodb" {
  alias             = "direct"
  connection_string = "mongodb://${var.admin_user}:${var.admin_pass}@${local.members[0].host}/admin?directConnection=true"
}

# Initialize replica set
resource "mongodb_replicaset" "cluster" {
  provider = mongodb.direct

  name    = local.replica_set_name
  members = local.members

  timeouts {
    create = "20m"
    update = "15m"
  }
}

# Connection string for applications
output "replica_set_connection_string" {
  value = "mongodb://${join(",", [for m in local.members : m.host])}/?replicaSet=${local.replica_set_name}"
  sensitive = false
}
```

### Adding Members Incrementally

```terraform
# Step 1: Initial 3-member replica set
resource "mongodb_replicaset" "incremental" {
  name = "rs-grow"

  members = [
    { id = 0, host = "mongo1:27017" },
    { id = 1, host = "mongo2:27017" },
    { id = 2, host = "mongo3:27017" }
  ]
}

# Step 2: Add one member at a time
# Uncomment and apply after initial creation
# members = [
#   { id = 0, host = "mongo1:27017" },
#   { id = 1, host = "mongo2:27017" },
#   { id = 2, host = "mongo3:27017" },
#   { id = 3, host = "mongo4:27017" }  # Add one member
# ]

# Step 3: Add another member
# Uncomment and apply after previous change
# members = [
#   { id = 0, host = "mongo1:27017" },
#   { id = 1, host = "mongo2:27017" },
#   { id = 2, host = "mongo3:27017" },
#   { id = 3, host = "mongo4:27017" },
#   { id = 4, host = "mongo5:27017" }  # Add another member
# ]
```


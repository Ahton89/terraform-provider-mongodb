# {{.Type}}: {{.Name}}

{{ .Description | trimspace }}

Retrieves a list of all databases from MongoDB, excluding system databases (`admin`, `config`, `local`).

Use this data source to discover existing databases or validate database creation.

## Example Usage

### List All Databases

```terraform
data "mongodb_databases" "all" {}

output "database_names" {
  value = [for db in data.mongodb_databases.all.databases : db.name]
}
```

### Check if Database Exists

```terraform
data "mongodb_databases" "all" {}

locals {
  target_database = "myapp"
  database_exists = contains([for db in data.mongodb_databases.all.databases : db.name], local.target_database)
}

output "myapp_exists" {
  value = local.database_exists
}
```

### Verify Database Creation

```terraform
resource "mongodb_database" "app" {
  name = "myapp_${var.environment}"
}

data "mongodb_databases" "verify" {
  depends_on = [mongodb_database.app]
}

output "created_database_exists" {
  value = contains(
    [for db in data.mongodb_databases.verify.databases : db.name],
    mongodb_database.app.name
  )
}
```

### Filter and Count Databases

```terraform
data "mongodb_databases" "all" {}

locals {
  # Filter databases by prefix
  app_databases = [
    for db in data.mongodb_databases.all.databases :
    db.name if startswith(db.name, "app_")
  ]

  # Count databases
  total_databases = length(data.mongodb_databases.all.databases)
}

output "app_databases" {
  value = local.app_databases
}

output "database_count" {
  value = local.total_databases
}
```

### Use with for_each

```terraform
data "mongodb_databases" "all" {}

# Create users for each database
resource "mongodb_user" "db_readers" {
  for_each = {
    for db in data.mongodb_databases.all.databases :
    db.name => db
  }

  username = "reader_${each.key}"
  password = var.reader_passwords[each.key]

  roles = [
    {
      role     = "read"
      database = each.value.name
    }
  ]
}
```

### Conditional Resource Creation

```terraform
data "mongodb_databases" "all" {}

locals {
  analytics_db_exists = contains(
    [for db in data.mongodb_databases.all.databases : db.name],
    "analytics"
  )
}

# Create database only if it doesn't exist
resource "mongodb_database" "analytics" {
  count = local.analytics_db_exists ? 0 : 1
  name  = "analytics"
}
```

### Database Inventory Report

```terraform
data "mongodb_databases" "all" {}

output "database_inventory" {
  description = "Complete inventory of MongoDB databases"
  value = {
    total_count = length(data.mongodb_databases.all.databases)
    databases   = data.mongodb_databases.all.databases
    names       = [for db in data.mongodb_databases.all.databases : db.name]
    timestamp   = timestamp()
  }
}
```


# {{.Type}}: {{.Name}}

{{ .Description | trimspace }}

Retrieves the current configuration of a MongoDB replica set, including member details and settings.

Use this data source to read existing replica set configuration, verify setup, or make decisions based on topology.

-> **Note:** This data source requires a replica set connection string (not direct connection).

## Example Usage

### Read Replica Set Configuration

```terraform
data "mongodb_replicaset" "current" {}

output "replica_set_name" {
  value = data.mongodb_replicaset.current.name
}

output "member_count" {
  value = length(data.mongodb_replicaset.current.members)
}
```

### List All Members

```terraform
data "mongodb_replicaset" "current" {}

output "member_hosts" {
  value = [for member in data.mongodb_replicaset.current.members : member.host]
}
```

### Find Primary-Eligible Members

```terraform
data "mongodb_replicaset" "current" {}

locals {
  primary_eligible = [
    for member in data.mongodb_replicaset.current.members :
    member.host if lookup(member, "priority", 1) > 0
  ]

  arbiters = [
    for member in data.mongodb_replicaset.current.members :
    member.host if lookup(member, "arbiter_only", false) == true
  ]

  hidden_members = [
    for member in data.mongodb_replicaset.current.members :
    member.host if lookup(member, "hidden", false) == true
  ]
}

output "primary_eligible_members" {
  value = local.primary_eligible
}

output "arbiter_members" {
  value = local.arbiters
}

output "hidden_members" {
  value = local.hidden_members
}
```

### Verify Replica Set Setup

```terraform
resource "mongodb_replicaset" "main" {
  name = "rs0"

  members = [
    { id = 0, host = "mongo1:27017" },
    { id = 1, host = "mongo2:27017" },
    { id = 2, host = "mongo3:27017" }
  ]
}

data "mongodb_replicaset" "verify" {
  depends_on = [mongodb_replicaset.main]
}

output "replica_set_configured" {
  value = data.mongodb_replicaset.verify.name == mongodb_replicaset.main.name
}

output "member_count_correct" {
  value = length(data.mongodb_replicaset.verify.members) == 3
}
```

### Generate Connection String

```terraform
data "mongodb_replicaset" "current" {}

locals {
  connection_string = "mongodb://${var.username}:${var.password}@${join(",", [for m in data.mongodb_replicaset.current.members : m.host])}/${var.database}?replicaSet=${data.mongodb_replicaset.current.name}"
}

output "app_connection_string" {
  value     = local.connection_string
  sensitive = true
}
```

### Replica Set Topology Report

```terraform
data "mongodb_replicaset" "current" {}

locals {
  topology_report = {
    name            = data.mongodb_replicaset.current.name
    total_members   = length(data.mongodb_replicaset.current.members)
    voting_members  = length([for m in data.mongodb_replicaset.current.members : m if lookup(m, "votes", 1) > 0])
    arbiters        = length([for m in data.mongodb_replicaset.current.members : m if lookup(m, "arbiter_only", false)])
    hidden_members  = length([for m in data.mongodb_replicaset.current.members : m if lookup(m, "hidden", false)])
    protocol_version = data.mongodb_replicaset.current.protocol_version
    members_detail = [
      for member in data.mongodb_replicaset.current.members : {
        id           = member.id
        host         = member.host
        priority     = lookup(member, "priority", 1)
        votes        = lookup(member, "votes", 1)
        arbiter      = lookup(member, "arbiter_only", false)
        hidden       = lookup(member, "hidden", false)
        delay_secs   = lookup(member, "secondary_delay_secs", 0)
      }
    ]
  }
}

output "topology" {
  value = local.topology_report
}
```

### Settings Analysis

```terraform
data "mongodb_replicaset" "current" {}

locals {
  has_custom_settings = data.mongodb_replicaset.current.settings != null

  settings_info = local.has_custom_settings ? {
    chaining_allowed        = data.mongodb_replicaset.current.settings.chaining_allowed
    heartbeat_interval_ms   = data.mongodb_replicaset.current.settings.heartbeat_interval_millis
    heartbeat_timeout_secs  = data.mongodb_replicaset.current.settings.heartbeat_timeout_secs
    election_timeout_ms     = data.mongodb_replicaset.current.settings.election_timeout_millis
  } : null
}

output "replica_set_settings" {
  value = local.settings_info
}
```

### High Availability Check

```terraform
data "mongodb_replicaset" "current" {}

locals {
  voting_members = length([
    for m in data.mongodb_replicaset.current.members :
    m if lookup(m, "votes", 1) > 0 && !lookup(m, "arbiter_only", false)
  ])

  has_quorum = local.voting_members >= 3

  ha_status = {
    voting_members_count = local.voting_members
    has_minimum_quorum   = local.has_quorum
    is_ha_compliant      = local.has_quorum && local.voting_members % 2 == 1
    recommendation       = local.has_quorum ? (
      local.voting_members % 2 == 0 ?
      "Consider using odd number of voting members" :
      "High availability configuration is optimal"
    ) : "Need at least 3 voting members for HA"
  }
}

output "high_availability_status" {
  value = local.ha_status
}
```

